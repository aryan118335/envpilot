{
  "name": "envpilot",
  "version": "1.0.0",
  "description": "Developer-first environment configuration auditor for JavaScript and TypeScript projects. Detect missing, unused, and inconsistent environment variables before deployment.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts -c eslint.config.mjs --ignore-pattern '**/*.d.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryan118335/envpilot.git"
  },
  "keywords": [
    "environment-variables",
    "env",
    "dotenv",
    "audit",
    "scanner",
    "typescript",
    "javascript",
    "cli",
    "linter",
    "configuration"
  ],
  "author": "aryan118335",
  "license": "MIT",
  "type": "module",
  "bin": {
    "envpilot": "dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/aryan118335/envpilot/issues"
  },
  "homepage": "https://github.com/aryan118335/envpilot#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "fast-glob": "^3.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15"
  }
}
